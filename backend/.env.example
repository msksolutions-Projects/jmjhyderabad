# Copy this file to .env for running on your own computer.
# On Render, enter the same names and values under the service's "Environment" tab instead.
# Never upload a real .env file to GitHub.

# MongoDB Atlas connection string (Atlas → your cluster → Connect → Drivers).
# Put a database name before the "?", e.g. ...mongodb.net/jmj_hyderabad?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/jmj_hyderabad?retryWrites=true&w=majority

# Secret key that protects admin sign-ins. At least 32 random characters; keep it private.
# Generate one in PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=

# Cloudinary (stores uploaded photos and PDFs). Cloudinary dashboard → "API Keys".
# Required on Render. Without these, uploads are saved on this computer (local testing only).
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Website addresses allowed to use this API (comma-separated). https://jmjhyderabad.vercel.app
# and http://localhost:5173 are always allowed; add a custom domain here if you get one.
CORS_ORIGINS=

# Set by Render automatically; 5000 when running locally.
PORT=5000
NODE_ENV=development
